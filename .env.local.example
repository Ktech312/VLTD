NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Billing (Account > Billing) - Upgrade/Update card/Cancel plan are fully wired
# in code already; they go live the moment these are set. Get the secret key
# and price IDs from the Stripe dashboard (Products > your Pro/Business plans).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# Google Sheets sync (Account > Workspace) - create an OAuth client at
# console.cloud.google.com (APIs & Services > Credentials), enable the
# Google Sheets API + Google Drive API, and add this app's origin as an
# authorized redirect URI: <your origin>/api/google/oauth-callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
